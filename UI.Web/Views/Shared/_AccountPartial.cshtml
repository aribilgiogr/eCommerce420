@using Core.Abstracts.IServices
@using Microsoft.AspNetCore.Identity

@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject IShopService ShopService
@{
    var cart = await ShopService.GetCurrentCartAsync(User);
}

<ul class="navbar-nav ms-auto align-items-center">
    @if (SignInManager.IsSignedIn(User))
    {
        <!-- Sepet Dropdown -->
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 fw-semibold text-dark"
                   href="#"
                   id="cartDropdown"
                   role="button"
                   data-bs-toggle="dropdown"
                   aria-expanded="false">
                <i class="bi bi-bag"></i>
                <span>Sepetim</span>
                @if (cart.Items.Any())
                {
                    <span class="badge bg-danger rounded-pill">@cart.Items.Count()</span>
                }
            </a>

            <!-- Sepet Dropdown Menu -->
            <div class="dropdown-menu dropdown-menu-end shadow border-0 mt-2"
                 aria-labelledby="cartDropdown"
                 style="width: 380px; max-height: 500px; overflow-y: auto;">
                
                @if (cart.Items.Any())
                {
                    <!-- Sepet İçeriği -->
                    <div class="dropdown-header bg-light border-bottom">
                        <h6 class="mb-0">Alışveriş Sepeti</h6>
                    </div>

                    <div class="p-2">
                        @foreach (var item in cart.Items)
                        {
                            <div class="d-flex gap-2 mb-3 p-2 border rounded align-items-start">
                                <!-- Ürün Resmi -->
                                @if (!string.IsNullOrEmpty(item.ProductImage))
                                {
                                    <img src="@item.ProductImage"
                                         alt="@item.ProductName"
                                         class="rounded"
                                         style="width: 60px; height: 60px; object-fit: cover;">
                                }
                                else
                                {
                                    <div class="bg-light rounded d-flex align-items-center justify-content-center fw-bold text-muted"
                                         style="width: 60px; height: 60px;">
                                        <i class="bi bi-image"></i>
                                    </div>
                                }

                                <!-- Ürün Bilgileri -->
                                <div class="flex-grow-1 min-w-0">
                                    <h6 class="mb-1 fw-semibold text-truncate" style="font-size: 0.9rem;">
                                        @item.ProductName
                                    </h6>
                                    
                                    <div class="d-flex gap-2 align-items-center mb-2">
                                        <span class="badge bg-secondary">@item.Quantity x</span>
                                    </div>

                                    <!-- Fiyat Bilgileri -->
                                    <div class="text-muted" style="font-size: 0.85rem;">
                                        @if (item.DiscountedPrice < item.ListPrice)
                                        {
                                            <div>
                                                <span class="text-decoration-line-through">@item.ListPrice.ToString("C")</span>
                                                <span class="text-danger fw-semibold">@item.DiscountedPrice.ToString("C")</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div>@item.ListPrice.ToString("C")</div>
                                        }
                                        <div class="text-dark fw-semibold">Toplam: @item.DiscountedTotal.ToString("C")</div>
                                    </div>
                                </div>

                                <!-- Kaldır Butonu -->
                                <button class="btn btn-sm btn-outline-danger"
                                        data-product-id="@item.ProductId"
                                        onclick="removeFromCart(@item.ProductId)"
                                        title="Sepetten Kaldır">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        }
                    </div>

                    <!-- Özet Bilgileri -->
                    <div class="dropdown-divider"></div>
                    <div class="p-3 bg-light">
                        <div class="d-flex justify-content-between mb-2" style="font-size: 0.9rem;">
                            <span>Ara Toplam:</span>
                            <span>@cart.TotalPrice.ToString("C")</span>
                        </div>
                        @if (cart.TotalDiscount > 0)
                        {
                            <div class="d-flex justify-content-between mb-2 text-success" style="font-size: 0.9rem;">
                                <span>İndirim:</span>
                                <span>-@cart.TotalDiscount.ToString("C")</span>
                            </div>
                        }
                        <div class="d-flex justify-content-between fw-bold border-top pt-2">
                            <span>Ödenecek Toplam:</span>
                            <span class="text-primary">@cart.TotalDue.ToString("C")</span>
                        </div>
                    </div>

                    <!-- Sepete Git Butonu -->
                    <div class="p-2 border-top">
                        <a href="@Url.Action("Index", "Cart")" class="btn btn-primary w-100 btn-sm">
                            <i class="bi bi-bag-check me-1"></i>Sepete Git
                        </a>
                    </div>
                }
                else
                {
                    <!-- Boş Sepet Mesajı -->
                    <div class="p-4 text-center">
                        <i class="bi bi-bag-x display-6 text-muted d-block mb-2"></i>
                        <p class="text-muted mb-0">Sepetiniz boş</p>
                        <small class="text-muted">Alışverişe başlamak için ürün ekleyin</small>
                    </div>
                }
            </div>
        </li>

        <!-- Hesap Dropdown -->
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 fw-semibold text-dark"
                   href="#"
                   id="accountDropdown"
                   role="button"
                   data-bs-toggle="dropdown"
                   aria-expanded="false">
                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold"
                     style="width: 32px; height: 32px; font-size: 0.9rem;">
                    @(User.Identity?.Name?[0].ToString().ToUpper() ?? "U")
                </div>
                <span>@User.Identity?.Name</span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2" aria-labelledby="accountDropdown">
                <li>
                    <a class="dropdown-item py-2" asp-controller="accounts" asp-action="index" title="Profil">
                        <i class="bi bi-person me-2"></i>Hesabım
                    </a>
                </li>
                <li><hr class="dropdown-divider opacity-50"></li>
                <li>
                    <form class="form-inline" asp-controller="accounts" asp-action="logout" method="post">
                        <button type="submit" class="dropdown-item text-danger py-2">
                            <i class="bi bi-box-arrow-right me-2"></i>Çıkış Yap
                        </button>
                    </form>
                </li>
            </ul>
        </li>
    }
    else
    {
        <!-- Ziyaretçi Menüsü -->
        <li class="nav-item me-2">
            <a class="nav-link text-dark fw-medium" asp-controller="Accounts" asp-action="Login">Giriş Yap</a>
        </li>
        <li class="nav-item">
            <a class="btn btn-primary btn-sm px-3 rounded-pill" asp-controller="Accounts" asp-action="Register">Kayıt Ol</a>
        </li>
    }
</ul>