@model Core.Concretes.DTOs.RegisterDto

@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="row justify-content-center mt-5">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-sm-5">

                <div class="text-center mb-4">
                    <h2 class="fw-bold">Hesap Oluştur</h2>
                    <p class="text-muted">Aramıza katılmak için formu doldurun</p>
                </div>

                <form asp-action="Register">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Email Field (Floating Label) -->
                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                        <label asp-for="Email"></label>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <!-- Password Field (Floating Label) -->
                    <div class="form-floating mb-3">
                        <input asp-for="Password" class="form-control" placeholder="Parola" />
                        <label asp-for="Password"></label>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <!-- Confirm Password Field (Floating Label) -->
                    <div class="form-floating mb-4">
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Parola Onayla" />
                        <label asp-for="ConfirmPassword"></label>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <!-- Submit Button -->
                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-primary btn-lg">Kayıt Ol</button>
                    </div>

                    <!-- Login Link -->
                    <div class="text-center mt-4">
                        <span class="text-muted">Zaten bir hesabınız var mı?</span>
                        <a asp-action="Login" class="text-decoration-none fw-semibold">Giriş Yap</a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}