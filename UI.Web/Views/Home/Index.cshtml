@model IEnumerable<Core.Concretes.DTOs.ProductListItemDto>

@{
	ViewData["Title"] = "Home Page";
}

<h1 class="display-4">Products</h1>

<section class="row row-cols-1 row-cols-md-3 g-3">
	@foreach (var item in Model)
	{
		<div class="col">
			<div class="card h-100">
				<img src="@(item.CoverImage ?? "https://placehold.co/600x400?text=No+Image")" class="card-img-top" alt="@item.Name" style="height: 200px; object-fit: cover;">
				<div class="card-body">
					<h6>@item.BrandName</h6>
					<h5>@item.Name</h5>
					<h6 class="text-muted">
						@item.SubcategoryName | @item.CategoryName
					</h6>
					@if (User!.Identity!.IsAuthenticated)
					{
						<form asp-action="addToCart" asp-route-productId="@item.Id" method="post">
							<button type="submit" class="btn btn-primary w-100">Add to Cart</button>
						</form>
					}
				</div>
			</div>
		</div>
	}
	@if (!Model.Any())
	{
		<div class="col mx-auto">
			<h5 class="text-center">Henüz Ürün Eklenmemiş!</h5>
		</div>
	}
</section>
